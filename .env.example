PORT=3000
JWT_SECRET=
JWT_EXPIRES_IN=1d
CORS_ALLOWED_ORIGINS=http://localhost:5173
DOCUMENT_CHECKLIST_APPLICATIONS_DB_PATH=
DOCUMENT_CHECKLIST_NOTIFICATIONS_DB_PATH=
DOCUMENT_CHECKLIST_UPLOADS_DIRECTORY=
EMAIL_ENABLED=false
EMAIL_FROM=
EMAIL_REPLY_TO=
# Frontend email-verification route; production must configure its HTTPS URL.
FRONTEND_EMAIL_VERIFICATION_URL=http://localhost:5173/verify-email
EMAIL_VERIFICATION_REQUEST_RATE_LIMIT_MAX=3
EMAIL_VERIFICATION_REQUEST_RATE_LIMIT_WINDOW_MS=900000
EMAIL_VERIFICATION_CONFIRM_RATE_LIMIT_MAX=10
EMAIL_VERIFICATION_CONFIRM_RATE_LIMIT_WINDOW_MS=900000
# Google OAuth is disabled by default. Set the following only after registering
# exact backend and frontend callback URLs with the OAuth deployment.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
FRONTEND_AUTH_CALLBACK_URL=http://localhost:5173/auth/google/callback
GOOGLE_OAUTH_RATE_LIMIT_MAX=20
GOOGLE_OAUTH_RATE_LIMIT_WINDOW_MS=900000
